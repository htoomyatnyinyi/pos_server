
// ENTERPRISE POS SYSTEM SCHEMA - POSTGRESQL OPTIMIZED
// 100% PRODUCTION READY - FINAL VERSION


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// TENANT & MULTI-TENANCY CORE


model Tenant {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  email     String?
  phone     String?
  isActive  Boolean  @default(true)
  
  subscription         TenantSubscription?
  subscriptionPayments SubscriptionPayment[]
  
  stores           Store[]
  users            User[]
  categories       Category[]
  products         Product[]
  suppliers        Supplier[]
  customers        Customer[]
  promotions       Promotion[]
  taxRates         TaxRate[]
  tenantFeatures   TenantFeature[]
  metrics          TenantMetric[]
  expenses         Expense[]
  expenseCategories ExpenseCategory[]
  purchaseOrders   PurchaseOrder[]
  productVariants  ProductVariant[]
  auditLogs        AuditLog[]
  apiKeys          ApiKey[]
  webhooks         Webhook[]
  fileAttachments  FileAttachment[]
  giftCards        GiftCard[]
  
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive])
  @@index([deletedAt])
  cashRegisters CashRegister[]
  supplierPayments SupplierPayment[]
  inventories Inventory[]
  priceHistories PriceHistory[]
  loyaltyTransactions LoyaltyTransaction[]
  customerWallets CustomerWallet[]
  walletTransactions WalletTransaction[]
  giftCardTransactions GiftCardTransaction[]
  orders Order[]
  payments Payment[]
  returns Return[]
  returnItems ReturnItem[]
  stockMovements StockMovement[]
  inventoryCounts InventoryCount[]
  inventoryCountItems InventoryCountItem[]
  stockTransfers StockTransfer[]
  stockTransferItems StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  sessions Session[]
  notifications Notification[]
  storeSettings StoreSetting[]
}

// 
// SUBSCRIPTION & SAAS MANAGEMENT
// 

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  
  priceMonthly   Decimal @db.Decimal(10, 2)
  priceYearly    Decimal @db.Decimal(10, 2)
  currency       String  @default("USD")
  
  maxStores      Int     @default(1)
  maxUsers       Int     @default(5)
  maxProducts    Int     @default(1000)
  maxCustomers   Int     @default(500)
  maxApiCalls    Int     @default(1000)
  
  features       Json     // Keep as JSON for nested data: {"advanced_reports": true, "api_access": true}
  
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)
  
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  subscriptions  TenantSubscription[]
  
  @@index([isActive])
  @@index([deletedAt])
}

model TenantSubscription {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  planId          String
  
  startDate       DateTime @default(now())
  endDate         DateTime?
  status          SubscriptionStatus @default(ACTIVE)
  
  autoRenew       Boolean @default(true)
  billingCycle    BillingCycle @default(MONTHLY)
  
  currentStores   Int @default(0)
  currentUsers    Int @default(0)
  currentProducts Int @default(0)
  currentCustomers Int @default(0)
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  payments        SubscriptionPayment[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([status, endDate])
}

model SubscriptionPayment {
  id              String   @id @default(cuid())
  tenantId        String
  subscriptionId  String
  
  amount          Decimal @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  transactionId   String?  @unique
  status          PaymentStatus @default(PAID)
  
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime @default(now())
  
  invoiceUrl      String?
  invoiceNumber   String?  @unique
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  subscription    TenantSubscription @relation(fields: [subscriptionId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, paidAt])
  @@index([status])
  @@index([transactionId])
}

// 
// FEATURE FLAGS
// 

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  key         String   @unique
  description String?
  
  category    FeatureCategory @default(GENERAL)
  isPremium   Boolean @default(false)
  isActive    Boolean @default(true)
  
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tenantFeatures TenantFeature[]
  
  @@index([isPremium])
  @@index([deletedAt])
}

model TenantFeature {
  tenantId    String
  featureId   String
  
  isEnabled   Boolean @default(true)
  enabledAt   DateTime @default(now())
  expiresAt   DateTime?
  
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  feature     FeatureFlag @relation(fields: [featureId], references: [id])
  
  @@id([tenantId, featureId])
}

// 
// SYSTEM ADMIN
// 

model SystemAdmin {
  id              String @id @default(cuid())
  email           String @unique
  passwordHash    String
  name            String
  role            SystemAdminRole @default(SUPER_ADMIN)
  
  twoFactorSecret String?
  isActive        Boolean @default(true)
  lastLoginAt     DateTime?
  lastLoginIP     String?
  
  auditLogs       SystemAuditLog[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([email, isActive])
}

model SystemAuditLog {
  id              String @id @default(cuid())
  adminId         String
  action          String
  entityType      String
  entityId        String
  oldData         Json?
  newData         Json?
  ipAddress       String?
  
  createdAt       DateTime @default(now())
  
  admin           SystemAdmin @relation(fields: [adminId], references: [id])
  
  @@index([entityType, entityId])
  @@index([adminId, createdAt])
}

// 
// USER MANAGEMENT
// 

model User {
  id              String   @id @default(cuid())
  username        String
  email           String?
  phone           String?
  passwordHash    String
  name            String
  
  role            Role     @default(CASHIER)
  
  isActive        Boolean  @default(true)
  lastLoginAt     DateTime?
  lastLoginIP     String?
  twoFactorSecret String?
  
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  
  stores          StoreUser[]
  orders          Order[]
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]
  sessions        Session[]
  notifications   Notification[]
  userPermissions UserPermission[]
  
  createdCounts   InventoryCount[] @relation("CreatedByUser")
  approvedCounts  InventoryCount[] @relation("ApprovedByUser")
  
  purchaseOrders  PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  
  transfersRequested StockTransfer[] @relation("TransferRequestedBy")
  transfersApproved  StockTransfer[] @relation("TransferApprovedBy")
  
  priceChanges    PriceHistory[] @relation("PriceChangedBy")
  paymentProcessed Payment[] @relation("PaymentProcessedBy")
  returnsApproved  Return[] @relation("ReturnApprovedBy")
  expensesCreated  Expense[] @relation("ExpenseCreatedBy")
  storeSettingsUpdated StoreSetting[] @relation("StoreSettingUpdatedBy")
  
  apiKeys         ApiKey[]
  
  deletedAt       DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  passwordResetTokens PasswordResetToken[]
  otpVerifications    OtpVerification[]
  
  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([role, isActive])
  @@index([deletedAt])
  @@index([tenantId, isActive])
}

model UserPermission {
  userId     String
  permission Permission
  
  user User @relation(fields: [userId], references: [id])
  
  @@id([userId, permission])
}

// 
// API & INTEGRATION
// 

model ApiKey {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  
  name            String
  key             String   @unique
  secret          String
  
  permissions     String[]  // PostgreSQL array: ["READ", "WRITE", "ADMIN"]
  
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  
  isActive        Boolean  @default(true)
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  user            User   @relation(fields: [userId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, isActive])
  @@index([key])
}

model Webhook {
  id              String   @id @default(cuid())
  tenantId        String
  
  name            String
  url             String
  events          String[]  // PostgreSQL array: ["ORDER.CREATED", "PAYMENT.RECEIVED"]
  
  secret          String?
  isActive        Boolean  @default(true)
  
  lastTriggeredAt DateTime?
  lastError       String?
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  
  deliveries      WebhookDelivery[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, isActive])
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  webhookId       String
  
  event           String
  payload         Json
  responseStatus  Int?
  responseBody    String?
  
  durationMs      Int?
  success         Boolean
  
  deliveredAt     DateTime @default(now())
  
  webhook         Webhook @relation(fields: [webhookId], references: [id])
  
  @@index([webhookId, deliveredAt])
  @@index([success])
}

model FileAttachment {
  id              String   @id @default(cuid())
  tenantId        String
  
  entityType      String   // "PRODUCT", "CUSTOMER", "EXPENSE"
  entityId        String
  
  fileName        String
  fileUrl         String
  fileSize        Int
  mimeType        String
  
  uploadedBy      String
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@index([tenantId, entityType, entityId])
}

model JobQueue {
  id              String   @id @default(cuid())
  tenantId        String?
  
  type            String   // "EMAIL", "REPORT", "SYNC"
  status          JobStatus @default(PENDING)
  payload         Json
  
  priority        Int      @default(0)
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  lastError       String?
  
  scheduledFor    DateTime @default(now())
  completedAt     DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([status, scheduledFor])
  @@index([tenantId, status])
}

// ============================================
// AUTHENTICATION
// ============================================

model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([token])
  @@index([expiresAt])
}

model OtpVerification {
  id          String   @id @default(cuid())
  userId      String
  code        String
  type        OtpType
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([userId, type])
  @@index([code])
}

// ============================================
// STORE MANAGEMENT
// ============================================

model Store {
  id          String @id @default(cuid())
  code        String
  name        String
  address     String?
  phone       String?
  email       String?
  taxNumber   String?
  
  isActive    Boolean @default(true)
  
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  
  deletedAt   DateTime?
  
  users           StoreUser[]
  storeSettings   StoreSetting[]
  inventoryCounts InventoryCount[]
  
  transfersFrom   StockTransfer[] @relation("FromStore")
  transfersTo     StockTransfer[] @relation("ToStore")
  
  orders          Order[]
  sessions        Session[]
  inventories     Inventory[]
  stockMovements  StockMovement[]
  
  cashRegisters   CashRegister[]
  expenses        Expense[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([deletedAt])
}

model StoreUser {
  storeId     String
  store       Store @relation(fields: [storeId], references: [id])
  
  userId      String
  user        User @relation(fields: [userId], references: [id])
  
  assignedAt  DateTime @default(now())
  isPrimary   Boolean  @default(false)
  
  @@id([storeId, userId])
  @@index([userId])
  @@index([storeId, isPrimary])
}

// ============================================
// CASH REGISTER
// ============================================

model CashRegister {
  id          String   @id @default(cuid())
  storeId     String
  tenantId    String
  name        String
  status      RegisterStatus @default(CLOSED)
  
  store       Store @relation(fields: [storeId], references: [id])
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  sessions    Session[]
  orders      Order[]
  
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([storeId, status])
  @@index([tenantId])
}

// ============================================
// PRODUCT CATALOG
// ============================================

model Category {
  id          String @id @default(cuid())
  name        String
  slug        String
  description String?
  
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  
  products    Product[]
  promotions  PromotionCategory[]
  
  isActive    Boolean @default(true)
  sortOrder   Int @default(0)
  
  deletedAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([tenantId, slug])
  @@unique([tenantId, name, parentId])
  @@index([parentId])
  @@index([tenantId, isActive])
}

model Supplier {
  id              String @id @default(cuid())
  code            String
  name            String
  contactName     String?
  phone           String?
  email           String?
  address         String?
  taxId           String?
  
  paymentTerms    Int?
  creditLimit     Decimal? @db.Decimal(12, 2)
  currentBalance  Decimal @default(0) @db.Decimal(12, 2)
  
  isActive        Boolean @default(true)
  
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  
  products        Product[]
  purchaseOrders  PurchaseOrder[]
  payments        SupplierPayment[]
  
  deletedAt       DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([deletedAt])
  @@index([tenantId, createdAt])
  @@index([name])
}

model SupplierPayment {
  id              String @id @default(cuid())
  tenantId        String
  supplierId      String
  
  amount          Decimal @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  
  note            String?
  
  paidAt          DateTime @default(now())
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@index([supplierId, paidAt])
  @@index([tenantId])
}

model Product {
  id                String @id @default(cuid())
  
  name              String
  description       String? @db.Text
  brand             String?
  
  sku               String
  barcode           String?
  
  costPrice         Decimal @db.Decimal(12, 2)
  sellingPrice      Decimal @db.Decimal(12, 2)
  wholesalePrice    Decimal? @db.Decimal(12, 2)
  
  promoPrice        Decimal? @db.Decimal(12, 2)
  promoStartAt      DateTime?
  promoEndAt        DateTime?
  
  isTaxable         Boolean @default(true)
  isActive          Boolean @default(true)
  isReturnable      Boolean @default(true)
  
  expiryDate        DateTime?
  manufacturingDate DateTime?
  bestBeforeDate    DateTime?
  
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  
  tenantId          String
  tenant            Tenant @relation(fields: [tenantId], references: [id])
  
  variants          ProductVariant[]
  inventories       Inventory[]
  orderItems        OrderItem[]
  stockMovements    StockMovement[]
  inventoryItems    InventoryCountItem[]
  stockTransferItems StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  promotionProducts PromotionProduct[]
  priceHistory      PriceHistory[]
  
  deletedAt         DateTime?
  version           Int @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([categoryId])
  @@index([tenantId, isActive])
  @@index([expiryDate])
  @@index([deletedAt])
  @@index([sku])
  @@index([barcode])
  @@index([tenantId, createdAt])
  @@index([name])
  @@index([brand])
}

model ProductVariant {
  id              String @id @default(cuid())
  name            String
  
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  
  sku             String
  barcode         String?
  
  price           Decimal @db.Decimal(12, 2)
  costPrice       Decimal @db.Decimal(12, 2)
  
  color           String?
  size            String?
  weight          Decimal? @db.Decimal(10, 3)
  
  isActive        Boolean @default(true)
  
  inventories       Inventory[]
  orderItems        OrderItem[]
  stockMovements    StockMovement[]
  inventoryItems    InventoryCountItem[]
  stockTransferItems StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  priceHistory      PriceHistory[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@unique([productId, name])
  @@index([productId])
  @@index([isActive])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

// 
// INVENTORY MANAGEMENT
// 

model Inventory {
  id            String @id @default(cuid())
  
  tenantId      String
  storeId       String
  productId     String
  variantId     String?
  
  quantity      Int @default(0)
  reservedQty   Int @default(0)
  
  reorderPoint  Int @default(10)
  reorderQty    Int @default(0)
  
  shelfLocation String?
  
  version       Int @default(0)
  
  tenant        Tenant @relation(fields: [tenantId], references: [id])
  store         Store @relation(fields: [storeId], references: [id])
  product       Product @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([storeId, productId, variantId])
  @@index([storeId, quantity])
  @@index([productId, storeId])
  @@index([reorderPoint, quantity])
  @@index([quantity])
  @@index([tenantId])
}

    // 
// PRICE HISTORY
// 

model PriceHistory {
  id          String @id @default(cuid())
  tenantId    String
  
  productId   String
  variantId   String?
  
  oldPrice    Decimal @db.Decimal(12, 2)
  newPrice    Decimal @db.Decimal(12, 2)
  
  changedById String
  reason      String?
  
  changedAt   DateTime @default(now())
  
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  changedBy   User @relation("PriceChangedBy", fields: [changedById], references: [id])
  
  @@index([productId, changedAt])
  @@index([variantId, changedAt])
  @@index([changedById])
  @@index([tenantId])
}

// 
// CUSTOMER MANAGEMENT
// 

model Customer {
  id              String @id @default(cuid())
  tenantId        String
  code            String
  
  name            String
  phone           String?
  email           String?
  address         String? @db.Text
  
  dateOfBirth     DateTime?
  gender          String?
  
  loyaltyPoints   Int @default(0)
  totalSpent      Decimal @default(0) @db.Decimal(12, 2)
  totalOrders     Int @default(0)
  
  debtAmount      Decimal @default(0) @db.Decimal(12, 2)
  creditLimit     Decimal? @db.Decimal(12, 2)
  
  tier            CustomerTier @default(BRONZE)
  tierValidUntil  DateTime?
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  
  orders          Order[]
  returns         Return[]
  loyaltyTransactions LoyaltyTransaction[]
  wallet          CustomerWallet?
  giftCards       GiftCard[]
  
  isActive        Boolean @default(true)
  deletedAt       DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([tenantId, code])
  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, loyaltyPoints])
  @@index([deletedAt])
  @@index([tenantId, createdAt])
  @@index([name])
}

model LoyaltyTransaction {
  id          String @id @default(cuid())
  tenantId    String
  customerId  String
  
  points      Int
  reason      String
  referenceId String?
  
  createdAt   DateTime @default(now())
  
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  
  @@index([customerId, createdAt])
  @@index([tenantId])
}

// 
// WALLET & GIFT CARDS
// 

model CustomerWallet {
  id              String @id @default(cuid())
  tenantId        String
  customerId      String @unique
  
  balance         Decimal @default(0) @db.Decimal(12, 2)
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  customer        Customer @relation(fields: [customerId], references: [id])
  transactions    WalletTransaction[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model WalletTransaction {
  id              String @id @default(cuid())
  tenantId        String
  walletId        String
  
  amount          Decimal @db.Decimal(12, 2)
  type            WalletTransactionType
  referenceId     String?
  description     String?
  
  wallet          CustomerWallet @relation(fields: [walletId], references: [id])
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@index([walletId, createdAt])
  @@index([tenantId])
}

model GiftCard {
  id              String @id @default(cuid())
  tenantId        String
  customerId      String?
  
  cardNumber      String @unique
  pinCode         String?
  
  initialAmount   Decimal @db.Decimal(12, 2)
  currentBalance  Decimal @db.Decimal(12, 2)
  
  expiresAt       DateTime?
  
  status          GiftCardStatus @default(ACTIVE)
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
  
  transactions    GiftCardTransaction[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, cardNumber])
  @@index([tenantId, status, expiresAt])
}

model GiftCardTransaction {
  id              String @id @default(cuid())
  tenantId        String
  giftCardId      String
  
  amount          Decimal @db.Decimal(12, 2)
  type            GiftCardTransactionType
  referenceId     String?
  
  giftCard        GiftCard @relation(fields: [giftCardId], references: [id])
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@index([giftCardId, createdAt])
  @@index([tenantId])
}

// 
// EXPENSE TRACKING
// 

model ExpenseCategory {
  id          String @id @default(cuid())
  tenantId    String
  name        String
  description String?
  
  isActive    Boolean @default(true)
  deletedAt   DateTime?
  
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  expenses    Expense[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([tenantId, name])
  @@index([deletedAt])
  @@index([tenantId])
}

model Expense {
  id          String @id @default(cuid())
  tenantId    String
  storeId     String?
  categoryId  String
  
  amount      Decimal @db.Decimal(12, 2)
  description String? @db.Text
  receiptUrl  String?
  
  expenseDate DateTime @default(now())
  createdById String
  
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  store       Store? @relation(fields: [storeId], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy   User @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId, expenseDate])
  @@index([storeId])
  @@index([categoryId])
  @@index([createdById])
  @@index([tenantId, createdAt])
}

// 
// ORDERS & TRANSACTIONS
// 

model Order {
  id               String @id @default(cuid())
  orderNumber      String
  
  tenantId         String
  customerId       String?
  userId           String
  sessionId        String?
  storeId          String?
  registerId       String?
  
  status           OrderStatus @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  
  subTotal         Decimal @db.Decimal(12, 2)
  taxAmount        Decimal @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal @default(0) @db.Decimal(12, 2)
  discountPercent  Decimal @default(0) @db.Decimal(5, 2)
  grandTotal       Decimal @db.Decimal(12, 2)
  
  paymentMethod    PaymentMethod @default(CASH)
  paidAmount       Decimal @default(0) @db.Decimal(12, 2)
  changeAmount     Decimal @default(0) @db.Decimal(12, 2)
  
  notes            String? @db.Text
  voidReason       String?
  
  version          Int @default(0)
  
  tenant           Tenant @relation(fields: [tenantId], references: [id])
  customer         Customer? @relation(fields: [customerId], references: [id])
  user             User @relation(fields: [userId], references: [id])
  session          Session? @relation(fields: [sessionId], references: [id])
  store            Store? @relation(fields: [storeId], references: [id])
  register         CashRegister? @relation(fields: [registerId], references: [id])
  
  items            OrderItem[]
  payments         Payment[]
  returns          Return[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  completedAt      DateTime?
  cancelledAt      DateTime?
  
  @@unique([tenantId, orderNumber])
  @@index([orderNumber])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([userId, createdAt])
  @@index([customerId])
  @@index([sessionId])
  @@index([storeId, status, createdAt])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id                String @id @default(cuid())
  
  orderId           String
  productId         String
  variantId         String?
  
  quantity          Int
  unitPrice         Decimal @db.Decimal(12, 2)
  
  discountPercent   Decimal @default(0) @db.Decimal(5, 2)
  discountAmount    Decimal @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal @default(0) @db.Decimal(12, 2)
  
  subTotal          Decimal @db.Decimal(12, 2)
  
  isReturned        Boolean @default(false)
  returnedQuantity  Int @default(0)
  
  order             Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  returnItems       ReturnItem[]
  
  createdAt         DateTime @default(now())
  
  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id                String @id @default(cuid())
  tenantId          String
  orderId           String
  
  amount            Decimal @db.Decimal(12, 2)
  method            PaymentMethod
  
  referenceNumber   String?
  status            PaymentStatus @default(PAID)
  
  processedById     String
  
  tenant            Tenant @relation(fields: [tenantId], references: [id])
  order             Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  processedBy       User @relation("PaymentProcessedBy", fields: [processedById], references: [id])
  
  processedAt       DateTime @default(now())
  
  @@index([orderId])
  @@index([referenceNumber])
  @@index([status])
  @@index([processedById])
  @@index([tenantId])
  @@index([processedAt])
  @@index([method])
}

// ============================================
// RETURNS
// ============================================

model Return {
  id                String @id @default(cuid())
  returnNumber      String @unique
  tenantId          String
  orderId           String
  customerId        String?
  
  totalAmount       Decimal @db.Decimal(12, 2)
  refundMethod      PaymentMethod
  refundStatus      RefundStatus @default(PENDING)
  
  reason            String @db.Text
  
  approvedById      String
  approvedAt        DateTime
  
  tenant            Tenant @relation(fields: [tenantId], references: [id])
  order             Order @relation(fields: [orderId], references: [id])
  customer          Customer? @relation(fields: [customerId], references: [id])
  approvedBy        User @relation("ReturnApprovedBy", fields: [approvedById], references: [id])
  
  items             ReturnItem[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([returnNumber])
  @@index([orderId])
  @@index([customerId])
  @@index([refundStatus])
  @@index([approvedById])
  @@index([createdAt])
  @@index([tenantId])
}

model ReturnItem {
  id                String @id @default(cuid())
  tenantId          String
  returnId          String
  orderItemId       String
  
  quantity          Int
  refundAmount      Decimal @db.Decimal(12, 2)
  reason            String?
  
  tenant            Tenant @relation(fields: [tenantId], references: [id])
  return            Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id])
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@index([tenantId])
}

// ============================================
// STOCK MOVEMENTS & TRANSFERS
// ============================================

model StockMovement {
  id              String @id @default(cuid())
  tenantId        String
  productId       String
  variantId       String?
  storeId         String?
  userId          String
  
  quantity        Int
  previousStock   Int
  newStock        Int
  
  type            MovementType
  referenceId     String
  referenceType   String
  reason          String? @db.Text
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  product         Product @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  store           Store? @relation(fields: [storeId], references: [id])
  user            User @relation(fields: [userId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@index([productId, createdAt])
  @@index([referenceId, referenceType])
  @@index([type, createdAt])
  @@index([storeId])
  @@index([variantId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([tenantId])
}

model InventoryCount {
  id               String @id @default(cuid())
  countNumber      String @unique
  tenantId         String
  storeId          String?
  
  status           StockCountStatus @default(DRAFT)
  scheduledDate    DateTime
  completedDate    DateTime?
  
  createdBy        String
  approvedBy       String?
  notes            String? @db.Text
  
  tenant           Tenant @relation(fields: [tenantId], references: [id])
  store            Store? @relation(fields: [storeId], references: [id])
  created          User @relation("CreatedByUser", fields: [createdBy], references: [id])
  approved         User? @relation("ApprovedByUser", fields: [approvedBy], references: [id])
  
  items            InventoryCountItem[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([status, scheduledDate])
  @@index([storeId, status])
  @@index([tenantId])
}

model InventoryCountItem {
  id                String @id @default(cuid())
  tenantId          String
  inventoryCountId  String
  productId         String
  variantId         String?
  
  systemQuantity    Int
  countedQuantity   Int
  variance          Int
  reason            String? @db.Text
  
  tenant            Tenant @relation(fields: [tenantId], references: [id])
  inventoryCount    InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  
  createdAt         DateTime @default(now())
  
  @@unique([inventoryCountId, productId, variantId])
  @@index([productId])
  @@index([variantId])
  @@index([tenantId])
}

model StockTransfer {
  id              String @id @default(cuid())
  transferNumber  String
  
  tenantId        String
  fromStoreId     String
  toStoreId       String
  
  status          TransferStatus @default(PENDING)
  
  requestedById   String
  approvedById    String?
  
  requestedAt     DateTime @default(now())
  completedAt     DateTime?
  notes           String? @db.Text
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  fromStore       Store @relation("FromStore", fields: [fromStoreId], references: [id])
  toStore         Store @relation("ToStore", fields: [toStoreId], references: [id])
  requestedBy     User @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy      User? @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  
  items           StockTransferItem[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([tenantId, transferNumber])
  @@index([transferNumber])
  @@index([fromStoreId, toStoreId])
  @@index([status])
  @@index([requestedById])
  @@index([tenantId])
  @@index([requestedAt])
}

model StockTransferItem {
  id                String @id @default(cuid())
  tenantId          String
  transferId        String
  productId         String
  variantId         String?
  
  quantity          Int
  receivedQuantity  Int?
  
  tenant            Tenant @relation(fields: [tenantId], references: [id])
  transfer          StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([transferId, productId, variantId])
  @@index([productId])
  @@index([variantId])
  @@index([tenantId])
}

// ============================================
// PURCHASE ORDERS
// ============================================

model PurchaseOrder {
  id               String @id @default(cuid())
  poNumber         String
  
  tenantId         String
  supplierId       String
  
  status           PurchaseOrderStatus @default(DRAFT)
  
  orderDate        DateTime @default(now())
  expectedDate     DateTime?
  receivedDate     DateTime?
  
  subTotal         Decimal @db.Decimal(12, 2)
  taxAmount        Decimal @default(0) @db.Decimal(12, 2)
  grandTotal       Decimal @db.Decimal(12, 2)
  
  createdById      String
  notes            String? @db.Text
  
  tenant           Tenant @relation(fields: [tenantId], references: [id])
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  createdBy        User @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  
  items            PurchaseOrderItem[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@unique([tenantId, poNumber])
  @@index([poNumber])
  @@index([supplierId, status])
  @@index([status])
  @@index([createdById])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model PurchaseOrderItem {
  id                String @id @default(cuid())
  tenantId          String
  poId              String
  productId         String
  variantId         String?
  
  quantity          Int
  unitCost          Decimal @db.Decimal(12, 2)
  totalCost         Decimal @db.Decimal(12, 2)
  receivedQuantity  Int @default(0)
  
  tenant            Tenant @relation(fields: [tenantId], references: [id])
  purchaseOrder     PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([poId, productId, variantId])
  @@index([productId])
  @@index([variantId])
  @@index([tenantId])
}

// ============================================
// SESSIONS & CASH MANAGEMENT
// ============================================

model Session {
  id                String @id @default(cuid())
  tenantId          String
  userId            String
  registerId        String?
  storeId           String?
  
  status            SessionStatus @default(OPEN)
  
  openedAt          DateTime @default(now())
  closedAt          DateTime?
  
  openingBalance    Decimal @default(0) @db.Decimal(12, 2)
  closingBalance    Decimal? @db.Decimal(12, 2)
  expectedBalance   Decimal? @db.Decimal(12, 2)
  discrepancy       Decimal? @db.Decimal(12, 2)
  
  cashSales         Decimal @default(0) @db.Decimal(12, 2)
  cardSales         Decimal @default(0) @db.Decimal(12, 2)
  digitalSales      Decimal @default(0) @db.Decimal(12, 2)
  
  notes             String? @db.Text
  
  tenant            Tenant @relation(fields: [tenantId], references: [id])
  user              User @relation(fields: [userId], references: [id])
  register          CashRegister? @relation(fields: [registerId], references: [id])
  store             Store? @relation(fields: [storeId], references: [id])
  
  orders            Order[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId, status])
  @@index([openedAt])
  @@index([storeId])
  @@index([registerId, status])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

// ============================================
// PROMOTIONS & DISCOUNTS
// ============================================

model Promotion {
  id              String @id @default(cuid())
  
  code            String
  name            String
  description     String?
  
  discountType    DiscountType
  discountValue   Decimal @db.Decimal(10, 2)
  
  minPurchase     Decimal? @db.Decimal(10, 2)
  minQuantity     Int?
  
  startDate       DateTime
  endDate         DateTime
  
  usageLimit      Int?
  usedCount       Int @default(0)
  perUserLimit    Int?
  
  applicableTo    DiscountApplicability @default(ALL_PRODUCTS)
  
  priority        Int @default(0)
  stackable       Boolean @default(false)
  
  isActive        Boolean @default(true)
  
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  
  products        PromotionProduct[]
  categories      PromotionCategory[]
  
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([tenantId, code])
  @@index([code, isActive])
  @@index([startDate, endDate])
  @@index([tenantId, isActive])
  @@index([deletedAt])
}

model PromotionProduct {
  promotionId     String
  productId       String
  
  promotion       Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionCategory {
  promotionId     String
  categoryId      String
  
  promotion       Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@id([promotionId, categoryId])
  @@index([categoryId])
}

// ============================================
// TAX MANAGEMENT - POSTGRESQL ARRAY VERSION
// ============================================

model TaxRate {
  id          String @id @default(cuid())
  
  tenantId    String
  name        String
  rate        Decimal @db.Decimal(5, 2)
  
  isCompound  Boolean @default(false)
  appliesTo   String[]  // PostgreSQL array: ["PRODUCT", "SERVICE", "SHIPPING"]
  
  validFrom   DateTime @default(now())
  validTo     DateTime?
  
  isActive    Boolean @default(true)
  
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([tenantId, name, validFrom])
  @@index([tenantId, isActive])
  @@index([deletedAt])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id              String @id @default(cuid())
  tenantId        String
  userId          String
  
  type            NotificationType
  title           String
  message         String @db.Text
  
  isRead          Boolean @default(false)
  metadata        Json?
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  user            User @relation(fields: [userId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([type])
  @@index([tenantId])
}

// ============================================
// AUDIT & LOGGING
// ============================================

model AuditLog {
  id              String @id @default(cuid())
  tenantId        String
  userId          String
  
  action          AuditAction
  entity          String
  entityId        String
  
  oldData         Json?
  newData         Json?
  changes         Json?
  
  ipAddress       String?
  userAgent       String?
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  user            User @relation(fields: [userId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@index([tenantId, createdAt])
}

model TenantMetric {
  id              String @id @default(cuid())
  tenantId        String
  
  metricDate      DateTime
  
  totalSales      Decimal @default(0) @db.Decimal(12, 2)
  totalOrders     Int @default(0)
  totalCustomers  Int @default(0)
  totalProducts   Int @default(0)
  
  revenue         Decimal @default(0) @db.Decimal(12, 2)
  profit          Decimal @default(0) @db.Decimal(12, 2)
  
  activeStores    Int @default(0)
  activeUsers     Int @default(0)
  
  avgOrderValue   Decimal @default(0) @db.Decimal(12, 2)
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  
  @@unique([tenantId, metricDate])
  @@index([metricDate])
}

// ============================================
// STORE SETTINGS
// ============================================

model StoreSetting {
  id              String @id @default(cuid())
  tenantId        String
  storeId         String?
  
  settingKey      String
  settingValue    Json
  
  description     String?
  updatedById     String
  
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  store           Store? @relation(fields: [storeId], references: [id])
  updatedBy       User @relation("StoreSettingUpdatedBy", fields: [updatedById], references: [id])
  
  updatedAt       DateTime @updatedAt
  
  @@unique([storeId, settingKey])
  @@index([settingKey])
  @@index([tenantId])
}

