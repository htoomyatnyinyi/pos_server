@baseUrl = http://localhost:6060/api
@authToken = {{login.response.body.token}}
@userId = {{login.response.body.id}}
@platformToken = {{platformLogin.response.body.token}}

### 1. Register a New User (with tenantCode)

# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "HTOO MYAT",
  "email": "htomyat@gmail.com",
  "password": "password123",
  "tenantName": "My Business",
  "tenantCode": "MYBIZ"
}

### 2. Login (with optional tenantCode)

# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "htomyat@gmail.com",
  "password": "password123",
  "tenantCode": "MYBIZ"
}

### 2a. Platform Login (for platform-level access)

# @name platformLogin
POST {{baseUrl}}/platform/auth/login
Content-Type: application/json

{
  "email": "root@minipos-platform.com",
  "password": "SuperAdmin123!"
}

### 2b. Get Current User Info

# @name getMe
GET {{baseUrl}}/auth/me
Authorization: Bearer {{authToken}}

### 2c. Get Platform User Info

# @name getPlatformMe
GET {{baseUrl}}/platform/auth/me
Authorization: Bearer {{platformToken}}

### ============================================
### PLATFORM - TENANTS (Platform Admin Only)
### ============================================

### Get All Tenants

# @name getTenants
GET {{baseUrl}}/platform/platform/tenants/
Authorization: Bearer {{platformToken}}

### Create a Tenant

# @name createTenant
POST {{baseUrl}}/platform/platform/tenants/
Content-Type: application/json
Authorization: Bearer {{platformToken}}

{
  "code": "TENANT-001",
  "name": "New Business Tenant",
  "email": "tenant@business.com",
  "phone": "09123456789"
}

@tenantId = {{createTenant.response.body.tenant.id}}

### Get Tenant by ID

# @name getTenantById
GET {{baseUrl}}/platform/tenants/{{tenantId}}
Authorization: Bearer {{platformToken}}

### Update Tenant

# @name updateTenant
PUT {{baseUrl}}/platform/tenants/{{tenantId}}
Content-Type: application/json
Authorization: Bearer {{platformToken}}

{
  "name": "Updated Business Name",
  "email": "updated@business.com",
  "phone": "09987654321",
  "isActive": true
}

### Delete Tenant

# @name deleteTenant
DELETE {{baseUrl}}/platform/tenants/{{tenantId}}
Authorization: Bearer {{platformToken}}

